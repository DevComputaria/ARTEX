# Configuração do Docker (copie para .env)
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM: configure um ou ambos, ou deixe vazio para configurar pela interface.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Perfil corporativo local: atualizações externas ficam desativadas por padrão.
# Defina 1 somente se o servidor puder consultar e baixar releases do GitHub.
ARTEX_SELF_UPDATE=0
